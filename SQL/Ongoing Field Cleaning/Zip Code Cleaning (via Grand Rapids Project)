drop table if exists #premier_zips_2
;
select distinct
	e.Zip as Premier_Zip
	, e.State
	, e.City
	,  case 
		when len(trim(e.Zip))< 5 
			then concat(replicate('0',5-len(trim(e.Zip))),trim(e.Zip))
		when len(trim(e.Zip))> 5 and e.Zip like '%-%' and len(left(trim(e.Zip),charindex('-',trim(e.Zip))))=5 
			then left(trim(e.Zip),5)
		when len(trim(e.Zip))> 5 and e.Zip like '%e+%' 
			then left(replace(trim(e.Zip),'.',''), 5) 
		when len(trim(e.Zip))> 5 
			then left(trim(e.Zip),5) 
		else trim(e.Zip) 
			end as Fixed_Zip
	, cast(0 as float) as Latitude
	, cast(0 as float) as Longitude
into #premier_zips_2
from WOrkBench.dbo.ELIGIBILITY_ALL_RAW e
;

select 'ALL' '#premier_zips_2';
select * from #premier_zips_2;


update pz2
SET latitude = z.Latitude
, Longitude = z.Longitude
FROM #premier_zips_2 pz2 
LEFT JOIN WorkBench.dbo.vw_Dim_ZipCodes z
	on case when pz2.Fixed_Zip not like '%[A-Za-z]%' 
				and pz2.Fixed_Zip not like '%-%' 
				and pz2.Fixed_Zip not like '%.%'
				and pz2.Fixed_Zip not like '%/%'
		then cast(cast(pz2.Fixed_Zip as int) as varchar(20))
			else pz2.Fixed_Zip end = z.Zip
where pz2.Latitude = 0 and pz2.Longitude = 0
;

