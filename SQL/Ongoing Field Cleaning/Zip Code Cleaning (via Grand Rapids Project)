drop table if exists #grand_rapids;
select distinct Zip
, City
, StateAbbreviated
, Longitude
, Latitude
into #grand_rapids
from WorkBench.dbo.vw_Dim_ZipCodes
where city like '%Grand Rapids%'
	and StateAbbreviated = 'MI'
;


