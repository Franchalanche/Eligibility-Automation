select * from #grand_rapids;

drop table if exists #new_basis;
select distinct pz.Fixed_Zip as Premier_Zip
, pz.Latitude as Premier_Latitude
, pz.Longitude as Premier_Longitude
, gr.Zip as GrandRapids_Zip
, gr.Longitude as GrandRapids_Longitude
, cast(0 as float) as Distance
, gr.Latitude as GrandRapids_Latitude
, gr.City
, gr.StateAbbreviated
into #new_basis
FROM #premier_zips_2_fixed pz
cross apply #grand_rapids gr
;

select '' '#new_basis';
select top 100000 * from #new_basis
order by Premier_Zip, GrandRapids_Zip;


drop table if exists #better_basis;
select distinct
	Premier_Zip
	, Premier_Latitude
	, Premier_Longitude
	, GrandRapids_Zip
	, GrandRapids_Longitude
	, GrandRapids_Latitude
	, Distance
	, City
	, StateAbbreviated
into #better_basis
FROM #new_basis
order by Premier_Zip
;


select '' '#better_basis';
select * from #better_basis
order by Premier_Zip, GrandRapids_Zip;

update #better_basis 
set Distance = geography::Point(Premier_Latitude, Premier_Longitude, 4326).STDistance(geography::Point(GrandRapids_Latitude, GrandRapids_Longitude, 4326))/1609.34
;

select 'POST GEOGRAPHY DISTANCE UPDATE' '#better_basis';
select * from #better_basis
where Distance <=50
order by Premier_Zip, Distance;

drop table if exists #better_basis_2;

with min_distance as 
(
	select 
	  Premier_Zip
	, min(Distance) 
		as Closest_to_Grand_Rapids
	FROM #better_basis
	group by Premier_Zip
	)
select md.*
, zip.City
, zip.State
, Premier_Latitude
, Premier_Longitude
, GrandRapids_Zip
, GrandRapids_Longitude
, GrandRapids_Latitude
, cast(0 as varchar(20)) as Range_Name
into #better_basis_2
from min_distance md 
left join #better_basis bb
	on md.Premier_Zip = bb.Premier_Zip
		and md.Closest_to_Grand_Rapids = bb.Distance
left join WOrkbench.dbo.vw_Dim_ZipCodes zip
	on md.Premier_Zip = zip.Zip
;

select '' '#better_basis_2';
select * from #better_basis_2
--;

UPDATE #better_basis_2
set Range_Name =
	case when --Closest_to_Grand_Rapids > 0 and 
				Closest_to_Grand_Rapids <= 10 
			then '00 - 10'
		when Closest_to_Grand_Rapids > 10 and Closest_to_Grand_Rapids <= 20 then '10 - 20'
		when Closest_to_Grand_Rapids > 20 and Closest_to_Grand_Rapids <= 30 then '20 - 30'
		when Closest_to_Grand_Rapids > 30 and Closest_to_Grand_Rapids <= 40 then '30 - 40'
		when Closest_to_Grand_Rapids > 40 and Closest_to_Grand_Rapids <= 50 then '40 - 50'
		when Closest_to_Grand_Rapids > 50 and Closest_to_Grand_Rapids <= 60 then '50 - 60'
		when Closest_to_Grand_Rapids > 60 and Closest_to_Grand_Rapids <= 70 then '60 - 70'
		when Closest_to_Grand_Rapids > 70 and Closest_to_Grand_Rapids <= 80 then '70 - 80'
		when Closest_to_Grand_Rapids > 70 and Closest_to_Grand_Rapids <= 80 then '80 - 90'
	else '90+' END
;


select 'Post Range Name Update' '#better_basis_2';
select * 
from #better_basis_2
order by Closest_to_Grand_Rapids
;

drop table if exists #updated_elig_basis;

select --distinct 
	contract
	, Zip
	, count(distinct(concat(Member_ID,New_Relationship,First_Name,Date_of_Birth))) as Unique_Members
	, case 
		when len(trim(e.Zip))< 5 
			then concat(replicate('0',5-len(trim(e.Zip))),trim(e.Zip))
		when len(trim(e.Zip))> 5 and e.Zip like '%-%' and len(left(trim(e.Zip),charindex('-',trim(e.Zip))))=5 
			then left(trim(e.Zip),5)
		when len(trim(e.Zip))> 5 and e.Zip like '%e+%' 
			then left(replace(trim(e.Zip),'.',''), 5) 
		when len(trim(e.Zip))> 5 
			then left(trim(e.Zip),5) 
		else trim(e.Zip) 
			end as Fixed_Zip
into #updated_elig_basis
FROM WOrkBench.dbo.ELIGIBILITY_ALL_RAW e
group by contract
	, Zip
;

